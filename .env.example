# Environment Template for Local Development
# Copy to .env and fill in your actual values
# Usage: export $(cat .env | xargs)

# Google Gemini API Key (required)
# Get yours from: https://ai.google.dev/
GEMINI_API_KEY=sk-your-api-key-here

# Optional: Set to 'true' to skip PDF downloads and use existing data
SKIP_PDF_DOWNLOAD=false

# Optional: Custom output paths
QUIZZES_OUTPUT=quizzes.json
TOPICS_OUTPUT=topics.json
